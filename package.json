{
  "name": "ftth-inventory",
  "version": "0.1.0",
  "description": "FTTH field inventory tracking — API, warehouse dashboard, and field tech app",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run start -w apps/mobile",
    "start:api": "npm start -w apps/api",
    "build:web": "npm run build -w apps/web",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "test": "npm test -w apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
