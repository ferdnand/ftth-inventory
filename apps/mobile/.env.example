# Leave this BLANK for normal development.
#
# The API host is derived automatically from the Metro host — in Expo Go that IS
# your dev machine's LAN IP, so it self-heals when DHCP hands out a new address
# or you switch networks. See src/lib/config.js.
#
# Set it only to point at an API that is not on your dev machine's :4000.
#
# WARNING: EXPO_PUBLIC_* values are inlined into the JavaScript bundle. Never
# put a secret here.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000/api
