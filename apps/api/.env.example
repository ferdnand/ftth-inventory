DATABASE_URL=postgres://user:password@localhost:5432/ftth_inventory
PORT=4000

# Sign key for JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_TTL=12h

# Timezone every DB session runs in, so report date bucketing is deterministic.
DB_TIMEZONE=UTC

# Comma-separated browser origins allowed to call the API. Empty = permissive
# (development only). Set this before deploying anywhere real.
CORS_ORIGINS=

# Separate database for `npm test`. The suite TRUNCATES tables, so this must
# never point at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/ftth_inventory_test
