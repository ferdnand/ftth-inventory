# Dev: leave as /api so requests go through the Vite proxy (same-origin, so CORS
# is never a variable). Deployed: set the full API origin, e.g.
#   VITE_API_BASE_URL=https://api.ftth.example/api
VITE_API_BASE_URL=/api

# Where `npm run dev` proxies /api to. Only change if the API is not on :4000.
# API_PROXY_TARGET=http://localhost:4000
